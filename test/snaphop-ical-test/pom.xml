  <artifactId>snaphop-ical-test</artifactId>
  <name>snaphop-ical-test</name>
  <description>End to end tests, with ical4j as the oracle</description>

  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>snaphop-ical</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
